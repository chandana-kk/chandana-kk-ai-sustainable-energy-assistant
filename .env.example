# MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=smart_energy

# JWT
JWT_SECRET_KEY=change-this-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# App
APP_NAME=Smart Energy AI
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Energy simulation
SIMULATION_INTERVAL_SECONDS=3
ELECTRICITY_RATE_PER_KWH=8.5
PEAK_RATE_MULTIPLIER=1.4
BILL_ALERT_THRESHOLD=5000

# ML
ML_MODELS_PATH=../ml_models/saved_models

# IoT (future ESP32 + SCT-013)
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC_ENERGY=home/energy/readings
MQTT_ENABLED=false

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/ws/energy
